{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "invoice-generator",
  "compatibility_date": "2026-09-15",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SUBSCRIBERS",
      "id": "YOUR_KV_NAMESPACE_ID_HERE"
    }
  ]
}
