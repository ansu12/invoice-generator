---
import { languages } from '../i18n/translations';

const currentPath = Astro.url.pathname;
// Remove any existing language prefix
const pathWithoutLang = currentPath.replace(/^\/(es|hi|fr|de|pt)\//, '/').replace(/^\/(es|hi|fr|de|pt)$/, '/');

const getPathForLang = (lang: string) => {
  if (lang === 'en') return pathWithoutLang;
  return `/${lang}${pathWithoutLang.replace(/\/$/, '')}/`.replace(/\/\//g, '/');
};

const currentLang = Astro.currentLocale || 'en';
---
<div class="relative group inline-block z-50">
  <button aria-haspopup="true" aria-expanded="false" class="flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-lg transition-colors border border-transparent hover:border-slate-200">
    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    <span class="uppercase">{currentLang}</span>
    <svg class="w-3 h-3 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
  </button>
  
  <div class="absolute right-0 mt-1 w-32 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/50 overflow-hidden transform origin-top-right scale-95 group-hover:scale-100">
    <div class="py-1">
      {Object.entries(languages).filter(([code]) => ['en', 'es', 'hi', 'fr', 'de', 'pt'].includes(code)).map(([code, name]) => (
        <a 
          href={getPathForLang(code)}
          class={`block px-4 py-2 text-sm transition-colors ${currentLang === code ? 'bg-blue-50 text-blue-700 font-semibold' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900'}`}
        >
          {name}
        </a>
      ))}
    </div>
  </div>
</div>
