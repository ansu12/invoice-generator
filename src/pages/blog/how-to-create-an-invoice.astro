        </div>
      </div>

      <!-- Related links -->
      <div class="not-prose mt-8 grid sm:grid-cols-2 gap-4">
        <a href="/blog/what-is-an-invoice" class="block p-5 bg-white border border-slate-200 rounded-xl hover:border-blue-400 hover:shadow-sm transition-all group">
          <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Related Guide</p>
          <p class="font-semibold text-slate-900 group-hover:text-blue-600">What Is an Invoice? &rarr;</p>
