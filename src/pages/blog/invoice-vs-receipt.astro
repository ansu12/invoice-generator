        <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-[10px] transition-colors">Start Invoicing Free</a>
      </div>

    </div>
  </article>

  <Footer />
</BaseLayout>
