---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Terms of Service | Free Invoice Generator" description="Terms of service for our free invoice tool.">
  <Navbar />
  
  <main class="max-w-3xl mx-auto px-6 py-24">
    <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4">Terms of Service</h1>
    <p class="text-slate-500 mb-8">Last Updated: September 16, 2026</p>
    
    <div class="prose prose-slate prose-lg">
      <p>
        By accessing and using this website, you agree to comply with and be bound by the following Terms of Service.
      </p>

      <h3>Free to Use</h3>
      <p>
        This is a free utility. You are permitted to use this tool for both personal and commercial purposes without paying any fees or creating an account.
      </p>

      <h3>Not Financial Advice</h3>
      <p>
        The documents generated by this tool do not constitute legal or financial advice. It is your sole responsibility to ensure that your invoices comply with all applicable local, state, and federal laws regarding taxation and business reporting.
      </p>

      <h3>No Warranty</h3>
      <p>
        This tool is provided "as is" without any warranties of any kind. Because the tool operates entirely locally within your web browser, we accept zero liability for any data loss, corrupted files, or unsaved work. We make no guarantees regarding the mathematical accuracy or legal compliance of the generated documents.
      </p>

      <div class="mt-12">
        <a href="/" class="text-blue-600 font-semibold hover:underline">&larr; Back to the Invoice Generator</a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
