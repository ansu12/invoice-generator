---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";
import InvoiceGenerator from "../components/InvoiceGenerator";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does invoice generator free actually mean — are there hidden fees?",
      "acceptedAnswer": { "@type": "Answer", "text": "It means 100% free with no hidden fees or paywalls." }
    },
    {
      "@type": "Question",
      "name": "How is this different from other 'free' invoice apps?",
      "acceptedAnswer": { "@type": "Answer", "text": "Other apps have hidden limits or watermarks; ours does not." }
    },
    {
      "@type": "Question",
      "name": "Can I use this free invoice generator for my freelance business?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, it is designed for freelancers." }
    },
    {
      "@type": "Question",
      "name": "Do I need to create an account?",
      "acceptedAnswer": { "@type": "Answer", "text": "No account is required." }
    },
    {
      "@type": "Question",
      "name": "What happens to my invoice data?",
      "acceptedAnswer": { "@type": "Answer", "text": "Your data stays on your device." }
    }
  ]
};
---
<BaseLayout
  title="Invoice Generator Free � Unlimited Invoices"
  description="Looking for an invoice generator free of charge? Create unlimited invoices with our tool. No hidden limits, no paywalls, no watermarks, no signup needed."
>
  <Schema data={faqSchema} slot="schema" />
  <Navbar />

  <section class="pt-20 pb-12 text-center bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-6">
        Invoice Generator Free
      </h1>
      <p class="text-xl text-slate-500 mb-8 max-w-lg mx-auto">No catch. No limits. No signup.</p>
      <a href="#invoice-tool" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-[10px] text-base transition-colors shadow-lg">
        Generate Free Invoice &darr;
      </a>
    </div>
  </section>

  <InvoiceGenerator client:load />

  <article class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 prose prose-slate">
      <h2 class="text-3xl font-bold text-slate-900 mb-6">The Freemium Problem with Most Invoice Generators</h2>
      <p class="mb-6 text-slate-600">The bait-and-switch: sign up for free, create 2-3 invoices, hit the paywall. Watermarks on PDFs. Export requires upgrade. Suddenly "free" costs $15/month.</p>
      
      <h2 class="text-3xl font-bold text-slate-900 mb-6">What "Invoice Generator Free" Actually Means Here</h2>
      <p class="mb-6 text-slate-600">This tool: no account, no limits, no watermarks, no export fees, no time restrictions, works forever.</p>
      
      <h2 class="text-3xl font-bold text-slate-900 mb-6">Real Use Cases — Who Uses a Free Invoice Generator?</h2>
      
      <h3 class="text-xl font-semibold text-slate-900 mt-6 mb-2">Freelancers & Independent Contractors</h3>
      <p class="mb-4 text-slate-600">Designers, developers, writers, photographers who invoice clients monthly.</p>
      
      <h3 class="text-xl font-semibold text-slate-900 mt-6 mb-2">Tradespeople & Service Providers</h3>
      <p class="mb-4 text-slate-600">Plumbers, electricians, cleaners who need quick field invoices.</p>
      
      <h3 class="text-xl font-semibold text-slate-900 mt-6 mb-2">Small Business Owners</h3>
      <p class="mb-8 text-slate-600">Retail, food, services who need professional invoices without accounting software overhead.</p>
    </div>
  </article>

  <section class="py-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-4xl font-bold text-slate-900 tracking-tight text-center mb-14">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map(item => (
          <details class="group bg-white rounded-[12px] border border-slate-200">
            <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-slate-900 list-none">
              {item.name}
              <svg class="transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4 text-slate-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p class="px-6 pb-5 text-slate-500 text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
      <p class="text-center mt-12 text-slate-600">
        Use our <a href="/" class="text-blue-600 hover:underline">invoice generator</a> — the free, no-signup tool trusted by thousands.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>
