---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";
import InvoiceGenerator from "../components/InvoiceGenerator";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is there really no signup to use this free invoice generator?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, completely free with no signup required." }
    },
    {
      "@type": "Question",
      "name": "How many free invoices can I create?",
      "acceptedAnswer": { "@type": "Answer", "text": "You can create an unlimited number of invoices." }
    },
    {
      "@type": "Question",
      "name": "Will there be a watermark on my free PDF invoice?",
      "acceptedAnswer": { "@type": "Answer", "text": "No, your PDFs will be 100% watermark-free." }
    },
    {
      "@type": "Question",
      "name": "Can I use this free invoice generator for my freelance business?",
      "acceptedAnswer": { "@type": "Answer", "text": "Absolutely, it is perfect for freelancers and contractors." }
    },
    {
      "@type": "Question",
      "name": "Is my invoice data stored anywhere?",
      "acceptedAnswer": { "@type": "Answer", "text": "No, all data is processed in your browser and not saved to our servers." }
    }
  ]
};
---
<BaseLayout
  title="Free Online Invoice Generator � No Signup"
  description="The best free online invoice generator. Create, format, and download beautiful PDF invoices directly from your browser without creating an account."
  canonical="https://yourdomain.com/free-online-invoice-generator"
>
  <Schema data={faqSchema} slot="schema" />
  <Navbar />

  <section class="pt-20 pb-12 text-center bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-5xl md:text-6xl font-extrabold text-slate-900 tracking-tight mb-6">
        Free Online Invoice Generator
      </h1>
      <p class="text-xl text-slate-500 mb-8 max-w-lg mx-auto">No signup. No watermarks. No limits.</p>
      <a href="#invoice-tool" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-[10px] text-base transition-colors shadow-lg">
        Create Free Invoice &darr;
      </a>
    </div>
  </section>

  <InvoiceGenerator client:load />

  <article class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 prose prose-slate">
      <h2 class="text-3xl font-bold text-slate-900 mb-6">Why Most "Free" Invoice Generators Aren't Actually Free</h2>
      <p class="mb-6 text-slate-600">Most tools hide the PDF download behind a paywall, add watermarks, limit to 2-3 invoices per month, or force you to create an account.</p>
      
      <h2 class="text-3xl font-bold text-slate-900 mb-6">What Makes InvoiceGen Actually Free</h2>
      <ul class="list-disc pl-5 mb-6 text-slate-600 space-y-2">
        <li>No signup required</li>
        <li>No watermarks</li>
        <li>Unlimited invoices</li>
        <li>No PDF paywalls</li>
        <li>No time limits</li>
      </ul>

      <h2 class="text-3xl font-bold text-slate-900 mb-6">Who Uses This Free Invoice Generator?</h2>
      <h3 class="text-xl font-semibold text-slate-900 mt-6 mb-2">Freelancers & Designers</h3>
      <p class="mb-4 text-slate-600">Perfect for creatives who need to bill clients quickly.</p>
      
      <h3 class="text-xl font-semibold text-slate-900 mt-6 mb-2">Consultants</h3>
      <p class="mb-4 text-slate-600">Ideal for professional service providers.</p>
      
      <h3 class="text-xl font-semibold text-slate-900 mt-6 mb-2">Tradespeople</h3>
      <p class="mb-8 text-slate-600">Great for generating invoices on the go from your phone.</p>
    </div>
  </article>

  <section class="py-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-4xl font-bold text-slate-900 tracking-tight text-center mb-14">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map(item => (
          <details class="group bg-white rounded-[12px] border border-slate-200">
            <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-slate-900 list-none">
              {item.name}
              <svg class="transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4 text-slate-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p class="px-6 pb-5 text-slate-500 text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
      
      <p class="text-center mt-12 text-slate-600">
        Create unlimited professional invoices with our <a href="/" class="text-blue-600 hover:underline">invoice generator</a> — free, no account required.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>
