---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Schema from "../components/Schema.astro";
import InvoiceGenerator from "../components/InvoiceGenerator";
import ComparisonTable from "../components/ComparisonTable.astro";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do I need to download anything to use this online invoice generator?",
      "acceptedAnswer": { "@type": "Answer", "text": "No, it works completely in your browser." }
    },
    {
      "@type": "Question",
      "name": "Does this online invoice tool work on mobile?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, it is fully responsive and works great on phones." }
    },
    {
      "@type": "Question",
      "name": "Is the online invoice generator free to use?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, 100% free with no hidden limits." }
    },
    {
      "@type": "Question",
      "name": "Can I save my invoices online?",
      "acceptedAnswer": { "@type": "Answer", "text": "Since it requires no account, you download the PDF to save it." }
    },
    {
      "@type": "Question",
      "name": "What browsers does the online invoice generator support?",
      "acceptedAnswer": { "@type": "Answer", "text": "All modern browsers including Chrome, Safari, Firefox, and Edge." }
    }
  ]
};
---
<BaseLayout
  title="Online Invoice Generator — Create Invoices in Your Browser | InvoiceGen"
  description="Create professional invoices entirely in your browser. No downloads, no apps, no signup. Free online invoice generator with instant PDF download."
  canonical="https://yourdomain.com/online-invoice-generator"
>
  <Schema data={faqSchema} slot="schema" />
  <Navbar />

  <section class="pt-20 pb-12 text-center bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <h1 class="text-5xl md:text-6xl font-bold text-slate-900 tracking-tight leading-tight mb-4">Online Invoice Generator</h1>
      <p class="text-xl text-slate-500 mb-8 max-w-lg mx-auto">Create invoices in your browser. No apps, no downloads.</p>
      <a href="#invoice-tool" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-8 py-4 rounded-[10px] text-base transition-colors shadow-lg">
        Start Invoicing Online &darr;
      </a>
    </div>
  </section>

  <InvoiceGenerator client:load />

  <article class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-6 prose prose-slate">
      <h2 class="text-3xl font-bold text-slate-900 mb-6">Browser-Based Invoicing vs Desktop Apps</h2>
      <p class="mb-6 text-slate-600">Traditional tools require downloading, installing, and updating software. Browser-based tools work instantly on any device.</p>
      
      <h2 class="text-3xl font-bold text-slate-900 mb-6">Why Online Invoice Generators Are Better for Small Business</h2>
      <ul class="list-disc pl-5 mb-6 text-slate-600 space-y-2">
        <li>Accessible on any device</li>
        <li>No installation required</li>
        <li>Automatic updates</li>
        <li>Works on Mac, Windows, Linux, and Mobile</li>
      </ul>

      <h2 class="text-3xl font-bold text-slate-900 mb-6">What Our Online Invoice Generator Includes</h2>
      <ul class="list-disc pl-5 mb-10 text-slate-600 space-y-2">
        <li>Real-time preview</li>
        <li>US sales tax fields</li>
        <li>EIN support</li>
        <li>Multi-currency</li>
        <li>WhatsApp sharing</li>
        <li>Logo upload</li>
        <li>Instant PDF download</li>
      </ul>

      <h2 class="text-3xl font-bold text-slate-900 mb-6">How We Compare to Other Online Invoice Generators</h2>
      <ComparisonTable />
    </div>
  </article>

  <section class="py-20 bg-slate-50">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-4xl font-bold text-slate-900 tracking-tight text-center mb-14">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map(item => (
          <details class="group bg-white rounded-[12px] border border-slate-200">
            <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-slate-900 list-none">
              {item.name}
              <svg class="transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4 text-slate-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <p class="px-6 pb-5 text-slate-500 text-sm leading-relaxed">{item.acceptedAnswer.text}</p>
          </details>
        ))}
      </div>
      <p class="text-center mt-12 text-slate-600">
        Looking for a fully free option? Our <a href="/" class="text-blue-600 hover:underline">free invoice generator</a> homepage has everything you need.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>
